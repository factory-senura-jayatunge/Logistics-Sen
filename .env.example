# =============================================================================
# Acme Logistics - Environment Variables
# =============================================================================
# Copy this file to .env and adjust values for your environment.
# Default values work for local development out of the box.
# =============================================================================

# --- Frontend (Next.js) ---

# Backend API URL used by the frontend to make API calls.
# In production, set this to the deployed backend URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Log level for frontend pino logger (debug, info, warn, error).
LOG_LEVEL=debug

# Node environment (development, production, test).
NODE_ENV=development

# --- Backend (FastAPI) ---

# Backend server port (used by uvicorn).
BACKEND_PORT=8000

# Frontend origin for CORS (comma-separated if multiple).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- CI/CD ---

# Set to "true" in CI environments (GitHub Actions sets this automatically).
# Affects Playwright retries, worker count, and server reuse.
# CI=true
